# 讯飞"录音文件转写大模型"凭证（控制台 -> 服务管理 -> 接口认证信息）
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# 阿里云百炼 API Key（百炼控制台 -> API-KEY 管理，sk- 开头）
DASHSCOPE_API_KEY=

# 火山引擎豆包"大模型录音文件识别" API Key（控制台 -> API Key 管理）
VOLC_API_KEY=

# 火山引擎对象存储 TOS（用来把音频转成豆包接口要求的公网 URL）
# AK/SK 在 控制台 -> 访问控制 -> API访问密钥 获取；桶名自己起一个，第一次用会自动创建
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_BUCKET=luyin-api-audio
TOS_REGION=cn-beijing

# 选择识别引擎：mock（占位示例）| xfyun | bailian | doubao | local（详情页手动选择时会覆盖这个默认值）
ASR_PROVIDER=mock

# 本地识别服务地址（local-asr/server.py），改了端口才需要改这行
LOCAL_ASR_URL=http://127.0.0.1:8001
